FROM registry.fedoraproject.org/fedora:latest

# Install Go dependencies, wget, and essential build tools
RUN dnf install -y \
    wget \
    git \
    make \
    tar \
    && dnf clean all

# Download and install Go to /usr/local
RUN wget https://go.dev/dl/go1.27.3.linux-amd64.tar.gz && \
    rm -rf /usr/local/go && \
    tar -C /usr/local -xzf go1.27.3.linux-amd64.tar.gz && \
    rm go1.27.3.linux-amd64.tar.gz

# Permanently add Go and GOPATH bin to PATH for all subsequent layers and runtime
ENV PATH=/usr/local/go/bin:/root/go/bin:$PATH

# Install gopls (Go language server)
RUN go install golang.org/x/tools/gopls@latest

WORKDIR /workspace
