# Konung dedicated server settings (cmd/konung-server).
#
# Copy this file to konung-server.conf next to it and edit:
# scripts/konung-server.sh copies konung-server.conf into the server at every
# start, so "scripts/konung-server.sh restart" applies changes. Running the
# binary yourself, put it as server.conf in the data folder (-data DIR) or
# name it with -config FILE.
#
# Format: key = value, one per line; "#" starts a comment line; quotes
# around a value are optional. An unknown key or a bad value stops the server
# with a message. Command-line flags override this file; this file overrides
# the LAN version's SERVER file (name and session length).

# The server's name in the game's server list.
name = "Мой сервер"

# TCP game port; LAN discovery uses UDP on the same port. With the container
# script this is the port on your machine.
port = 7777

# Players at once (1–16; the original allowed 16).
max_players = 16

# Length of a rating session in minutes; at its end the ratings move and a
# new session starts.
minutes = 180

# World speed for everyone: 0 normal, 1 double, 2 triple (the single-player
# numpad +/−).
speed = 0

# Heroes of one team (the same hero type: Волк, Драгомир, Михаил) can hurt
# each other, as in the original. false protects teammates from each other.
team_damage = true
